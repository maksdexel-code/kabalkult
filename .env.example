# Copy to .env and fill in. .env is git-ignored: it never leaves this Mac.
# TESTNET ONLY. Use fresh wallets that hold no real funds.

# BSC Testnet RPC (public endpoint is fine to start)
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org

# Creator / launcher wallet private key (0x...)
DEPLOYER_PRIVATE_KEY=

# Trader wallet private key (0x...), simulates buys to move market cap
BUYER_PRIVATE_KEY=

# CoinMarketCap Pro API key (server-side relayer only, never in the front end)
CMC_API_KEY=

# ─── Token launch details (PUBLIC info, not secrets; fixed forever at launch) ───
# Token name and ticker shown on Flap and on the DEX.
KK_NAME=""
KK_SYMBOL=""
# One or two sentences shown on the token page.
KK_DESCRIPTION=""
# Optional links (leave "" if none).
KK_WEBSITE=""
KK_TWITTER=""
KK_TELEGRAM=""
# Token logo: put a PNG/JPG/WEBP/GIF (square, under ~1 MB) in the project folder and write its file name here.
KK_IMAGE="assets/token.png"
# Named KOLs: 2 PUBLIC wallet addresses, comma-separated, no spaces (KOL A will click Confirm, KOL B will not).
KK_NAMED_KOLS=""
# Campaign invitees: PUBLIC wallet addresses, comma-separated, no spaces (they join with "Confirm" in the UI).
KK_INVITEES=""
